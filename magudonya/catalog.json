{
  "schema_version": 1,
  "feed_title": "Magudonya — D&D Campaign Stories and Actual Plays",
  "created": "2026-10-19",
  "target_episodes": 120,
  "story_episodes": 60,
  "actual_play_episodes": 60,
  "interleave": "story then actual play, ten matched pairs per campaign theme",
  "themes": {
    "reach": {
      "title": "Veyrun’s Reach — Living City, Cultures and Conversations",
      "description": "Everyday city life, magical conveniences, practical interactions, social customs, neighborhoods and negotiated relationships; not generic city law or class etiquette."
    },
    "eilistraee": {
      "title": "Eilistraee — Drow Defectors, Refuge and Elven Relationships",
      "description": "The sanctuary southeast of Veyrun's Reach, Eilistraee's followers, Lolth defectors, allied high/wood elves, forest protection, trust and self-determination."
    },
    "itich": {
      "title": "Itich — Dwarven Ruins and Underground Survival",
      "description": "Primitive Itich insectoid survivors occupy an abandoned dwarven mine/forge, with no functioning metalworking; culture, survival, coexistence and exploration."
    },
    "wall": {
      "title": "The Wall — Screamers, Crystals and Psychic Echoes",
      "description": "Collapsed earth wall, screamers as semiastral cave bacteria, tamed Wallfeeder, psychic impressions, infectious metal crystals and ancient predatory minds."
    },
    "attina": {
      "title": "Attina — Transformations, Magic and Character-Driven Agency",
      "description": "Attina's anomaly, magic, particles, relationships, choices and transformations; inspire believable conversations, not artificial pace metrics."
    },
    "aberrations": {
      "title": "Ancient Minds — Aboleths, Illithids and Anomalies",
      "description": "Elder-brain/aboleth/mind-flayer psychology, mind prison, illusions, Weave disruption, scientific mysteries and an intelligent living world."
    }
  },
  "source_notes": "RSS enclosure URLs and lengths must be resolved from original publisher feeds, not invented. Source shows are inspiration and are not canon for Magudonya. Story serialization is sequential within each source; actual play remains distinct.",
